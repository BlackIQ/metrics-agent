[Unit]
Description=OpenHubble Metrics Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/openhubble-agent
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/local/bin/uv run fastapi run
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
